# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_password_here
ADMIN_PORT=8080

# Generate SECRET_KEY — pick one method:
#   With Python:  python3 -c "import secrets; print(secrets.token_hex(32))"
#   With OpenSSL: openssl rand -hex 32
SECRET_KEY=changeme_generate_with_command_above

# Generate ENCRYPTION_KEY — must be a Fernet key (32 url-safe base64 bytes) — pick one method:
#   With Python:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   With OpenSSL: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
#
# One-liner to patch both keys directly into this file (no Python needed):
#   sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(openssl rand -hex 32)|" .env
#   sed -i "s|^ENCRYPTION_KEY=.*|ENCRYPTION_KEY=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n')|" .env
ENCRYPTION_KEY=changeme_generate_with_command_above

# ── Docker / Networking ────────────────────────────────────────────────────────
PROXY_NETWORK_NAME=smtp_proxy_net
PROXY_IMAGE_NAME=smtp-proxy-tenant

# ── Port mode (each tenant gets a unique port) ─────────────────────────────────
PORT_MODE_ENABLED=true
PORT_MODE_BASE_PORT=10025

# ── Subdomain mode (all on port 587, differentiated by hostname) ───────────────
SUBDOMAIN_MODE_ENABLED=false
# Base domain, e.g. smtp.example.com → tenant gets tenant-name.smtp.example.com
SUBDOMAIN_BASE_DOMAIN=smtp.example.com

# ── Brute force defaults ───────────────────────────────────────────────────────
# Max failed login attempts before lockout
ADMIN_BF_MAX_ATTEMPTS=5
# Lockout duration in minutes
ADMIN_BF_LOCKOUT_MINUTES=15
# Proxy SMTP brute force
SMTP_BF_MAX_ATTEMPTS=5
SMTP_BF_LOCKOUT_MINUTES=30
